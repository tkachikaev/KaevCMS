includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app
        - routes
        - database
        - modules/daily-rewards/src
        - modules/promo-codes/src
        - modules/support-tickets/src

    level: 6
    tmpDir: storage/framework/cache/phpstan
    # Published migration is immutable; keep the historical signature unchanged.
    ignoreErrors:
        -
            identifier: missingType.parameter
            path: database/migrations/2026_07_12_000500_create_game_servers_table.php

    reportUnmatchedIgnoredErrors: true
