{
  "_WARNING_READ_BEFORE_CHANGING_DEPENDENCIES": [
    "==============================================================================",
    "STOP! DEPENDENCY CHANGES REQUIRE EXPLICIT OWNER APPROVAL.",
    "Do NOT update Laravel, Livewire or any Composer dependency, and do NOT change composer.json or composer.lock, without prior explicit approval from the KaevCMS owner.",
    "This applies to every task: new features, bug fixes, security audits and release preparation.",
    "Release builds and CI fail on unapproved changes: php deployment/dependencies/dependency-guard.php",
    "------------------------------------------------------------------------------",
    "СТОП! КАТЕГОРИЧЕСКИ ЗАПРЕЩЕНО обновлять Laravel, Livewire, Composer-зависимости или изменять composer.lock без предварительного явного согласования с владельцем KaevCMS.",
    "Это касается любых изменений — разработки новых функций, исправления ошибок, аудита безопасности и подготовки релизов.",
    "Сборка релиза и CI завершаются ошибкой при несогласованном изменении: php deployment/dependencies/dependency-guard.php",
    "=============================================================================="
  ],
  "name": "kaevcms/cms",
  "type": "project",
  "description": "KaevCMS — open-source CMS for Lineage II servers.",
  "keywords": [
    "lineage2",
    "l2j",
    "mobius",
    "cms",
    "laravel",
    "kaevcms"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-mbstring": "*",
    "laravel/framework": "^13.0",
    "laravel/tinker": "^3.0",
    "livewire/livewire": "^4.2"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "larastan/larastan": "^3.10",
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.25",
    "laravel/sail": "^1.42",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.8",
    "phpstan/phpstan": "^2.2.5",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "format": "pint",
    "lint": "pint --test",
    "analyse": "phpstan analyse --memory-limit=1G --no-progress",
    "test": "php artisan test",
    "quality": [
      "@lint",
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    },
    "platform": {
      "php": "8.3.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
